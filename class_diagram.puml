@startuml
' Diagrama de clases derivado del schema
skinparam classAttributeIconSize 0

class Sex {
  +id: int
  +name: varchar
}


class User {
  +id: int
  +sex_id: int
  +role: varchar
  +email: varchar
  +password: varchar
  +first_name: varchar
  +last_name: varchar
  +phone: varchar
  +photo_url: varchar
  --
  +register(params: Map): User
  +login(email: varchar, password: varchar): Token    ' POST /api/v1/sessions
  +updateProfile(params: Map): boolean
  +changePassword(oldPassword: varchar, newPassword: varchar): boolean
  +findById(id: int): User
}

class Client {
  +id: int
  +user_id: int
  +address: text
  +identity_document: varchar
  --
  +listPets(): List<Pet>                               ' GET /api/v1/clients/:id/pets
  +createPet(params: Map): Pet                         ' POST /api/v1/clients/:id/pets
  +updateProfile(params: Map): boolean                 ' PUT /api/v1/clients/:id
  +findById(id: int): Client                           ' GET /api/v1/clients/:id
}

class Veterinarian {
  +id: int
  +user_id: int
  +license_number: varchar
  +years_experience: int
  +default_appointment_duration_minutes: int
  --
  +listConsultations(status?: varchar): List<Consultation>  ' GET /api/v1/veterinarians/:id/consultations
  +updateConsultationStatus(consultationId: int, status: varchar): boolean ' PUT /api/v1/consultations/:id/status
  +listAvailability(dayOfWeek?: int): List<VeterinarianAvailability> ' GET /api/v1/veterinarians/:id/availability
  +getAvailableSlots(date: date): List<time>              ' GET /api/v1/veterinarians/:id/availability?date=YYYY-MM-DD
  +findById(id: int): Veterinarian                        ' GET /api/v1/veterinarians/:id
}

class Species {
  +id: int
  +name: varchar
  --
  +listAll(): List<Species>
  +findById(id: int): Species
}

class Breed {
  +id: int
  +species_id: int
  +name: varchar
  +description: text
  +reference_image_url: varchar
  --
  +getSpecies(): Species
  +listBySpecies(speciesId: int): List<Breed>
  +findById(id: int): Breed
  ' Endpoints: GET /api/v1/species, GET /api/v1/species/:id, GET /api/v1/species/:id/breeds
}

class Pet {
  +id: int
  +client_id: int
  +breed_id: int
  +sex_id: int
  +name: varchar
  +birth_date: date
  +current_weight: decimal
  +photo_url: varchar
  --
  +getAge(): int
  +updateProfile(params: Map): boolean                 ' PUT /api/v1/pets/:id
  +findById(id: int): Pet
}

class Specialty {
  +id: int
  +name: varchar
  +description: text
  +icon_url: varchar
  --
  +listAll(): List<Specialty>
  +findById(id: int): Specialty
  ' Endpoints: GET /api/v1/specialties, GET /api/v1/specialties/:id
}

class Consultation {
  +id: int
  +pet_id: int
  +veterinarian_id: int
  +status: varchar
  +consultation_date: date
  +consultation_time: time
  +reason: text
  +diagnosis: text
  +prescribed_treatment: text
  +rating: int
  +review_comment: text
  +review_datetime: datetime
  --
  +create(params: Map): Consultation        ' POST /api/v1/consultations (CU05)
  +confirm(): boolean                      ' PUT /api/v1/consultations/:id/confirm (CU08)
  +cancel(reason: varchar): boolean        ' PUT /api/v1/consultations/:id/cancel (CU08)
  +complete(diagnosis: text, treatment: text): boolean ' PUT /api/v1/consultations/:id/complete (CU09)
  +attachDocument(doc: ConsultationDocument): boolean  ' POST /api/v1/consultations/:id/documents (CU10)
  +addSpecialty(specialtyId: int): boolean
  +rate(rating: int, comment: varchar): boolean        ' POST /api/v1/consultations/:id/rate (CU07)
  +findById(id: int): Consultation
}

class ConsultationDocument {
  +id: int
  +consultation_id: int
  +file_url: varchar
  +document_type: varchar
  --
  +upload(file: File): ConsultationDocument  ' POST /api/v1/consultations/:id/documents
  +delete(): boolean
  +findById(id: int): ConsultationDocument
}

class ConsultationSpecialty {
  +consultation_id: int
  +specialty_id: int
  --
  +add(consultationId: int, specialtyId: int): ConsultationSpecialty
  +remove(consultationId: int, specialtyId: int): boolean
}

class VeterinarianAvailability {
  +id: int
  +veterinarian_id: int
  +day_of_week: int
  +start_time: time
  +end_time: time
  +slot_duration_minutes: int
  +is_active: boolean
  --
  +listForVeterinarian(vetId: int): List<VeterinarianAvailability>
  +activate(): boolean                              ' PUT /api/v1/veterinarians/:id/availability/:id/activate
  +deactivate(): boolean                            ' PUT /api/v1/veterinarians/:id/availability/:id/deactivate
  +findById(id: int): VeterinarianAvailability     ' GET /api/v1/veterinarians/:id/availability/:id
}

' Relaciones
User "1" -- "0..*" Client : has
User "1" -- "0..1" Veterinarian : has
Sex "1" -- "0..*" User : relates
Sex "1" -- "0..*" Pet : relates
Species "1" -- "0..*" Breed : contains
Breed "1" -- "0..*" Pet : contains
Client "1" -- "0..*" Pet : owns
Pet "1" -- "0..*" Consultation : has
Veterinarian "1" -- "0..*" Consultation : attends
Consultation "1" -- "0..*" ConsultationDocument : attaches
Consultation "1" -- "0..*" ConsultationSpecialty : classifies
Specialty "1" -- "0..*" ConsultationSpecialty : referenced
Veterinarian "1" -- "0..*" VeterinarianAvailability : defines

@enduml
