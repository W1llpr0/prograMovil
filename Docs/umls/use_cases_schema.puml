@startuml
left to right direction
skinparam packageStyle rectangle

actor "Usuario" as user
actor "Cliente" as client
actor "Veterinario" as vet
actor "Sistema\n(Supabase Trigger)" as system

client -up-|> user
vet -up-|> user

rectangle "Aplicación Móvil VetCare — BaaS / Supabase" {

  ' ===== CASOS DE USO =====

  usecase "CU01: Registrarse en la app" as UC1
  usecase "CU02: Iniciar Sesión\n(Supabase Auth / JWT)" as UC2
  usecase "CU03: Editar Perfil" as UC3

  usecase "CU04: Gestionar Mascotas" as UC4
  usecase "CU05: Agendar Consulta Médica" as UC5
  usecase "CU06: Visualizar Historial Clínico" as UC6
  usecase "CU07: Evaluar Atención" as UC7
  usecase "CU11: Registrar Cumplimiento\nde Tratamiento" as UC11
  usecase "CU12: Consultar Mapa\nEpidemiológico / Alertas Zonales" as UC12

  usecase "CU08: Gestionar Agenda Médica" as UC8
  usecase "CU09: Registrar Datos Médicos" as UC9
  usecase "CU10: Adjuntar Resultados Médicos" as UC10

  ' ===== SUBPROCESOS CU01 =====
  usecase "Ingresar datos de registro" as F1
  usecase "Seleccionar rol de usuario" as F2
  usecase "Confirmar registro" as F3

  ' ===== SUBPROCESOS CU02 =====
  usecase "Ingresar credenciales" as L1
  usecase "Autenticar con Supabase Auth" as L2

  ' ===== SUBPROCESOS CU03 =====
  usecase "Actualizar datos personales" as E1
  usecase "Actualizar imagen de perfil\n(Supabase Storage)" as E2

  ' ===== SUBPROCESOS CU04 =====
  usecase "Registrar mascota" as M1
  usecase "Actualizar mascota" as M2
  usecase "Consultar mascotas" as M3
  usecase "Registrar Seguimiento\nMorfológico" as M4
  usecase "Gestionar Bóveda Legal\n(CITES / Zoocriadero)" as M5

  ' ===== SUBPROCESOS CU05 =====
  usecase "Seleccionar mascota" as SM
  usecase "Seleccionar veterinario" as SV
  usecase "Seleccionar horario" as SH
  usecase "Confirmar cita médica" as SC

  ' ===== SUBPROCESOS CU06 =====
  usecase "Consultar historial clínico" as H1
  usecase "Consultar recetas médicas" as VR
  usecase "Descargar documentos clínicos\n(Supabase Storage)" as DD
  usecase "Generar/Verificar Token\nde Autenticidad (Hash SHA-256)" as HA

  ' ===== SUBPROCESOS CU07 =====
  usecase "Registrar calificación" as C1
  usecase "Registrar comentario" as C2

  ' ===== SUBPROCESOS CU08 =====
  usecase "Consultar agenda médica" as A1
  usecase "Actualizar estado de consulta" as A2

  ' ===== SUBPROCESOS CU09 =====
  usecase "Registrar diagnóstico" as D1
  usecase "Registrar tratamiento" as D2
  usecase "Generar cronograma\nde medicación (Trigger)" as D3
  usecase "Disparar alerta\nepidemiológica (Trigger)" as D4

  ' ===== SUBPROCESOS CU10 =====
  usecase "Cargar archivo clínico\n(Supabase Storage)" as R1
  usecase "Asociar archivo a consulta" as R2

  ' ===== SUBPROCESOS CU11 =====
  usecase "Recibir notificación push\nde toma programada" as AD1
  usecase "Confirmar toma de medicación" as AD2
  usecase "Consultar tasa de adherencia\n(Veterinario)" as AD3

  ' ===== SUBPROCESOS CU12 =====
  usecase "Ver mapa de brotes activos" as EP1
  usecase "Recibir alerta zonal\n(push notification)" as EP2
}

' ===== ACTORES =====
user --> UC1
user --> UC2
user --> UC3

client --> UC4
client --> UC5
client --> UC6
client --> UC7
client --> UC11
client --> UC12

vet --> UC8
vet --> UC9
vet --> UC10
vet --> AD3

system --> D3
system --> D4
system --> EP2

' ===== RELACIONES CU01 =====
UC1 --> F1 : <<include>>
UC1 --> F2 : <<include>>
UC1 --> F3 : <<include>>

' ===== RELACIONES CU02 =====
UC2 --> L1 : <<include>>
UC2 --> L2 : <<include>>

' ===== RELACIONES CU03 =====
UC3 --> E1 : <<include>>
UC3 ..> E2 : <<extend>>

' ===== RELACIONES CU04 =====
UC4 --> M1 : <<include>>
UC4 --> M2 : <<include>>
UC4 --> M3 : <<include>>
UC4 --> M4 : <<include>>
UC4 --> M5 : <<include>>

' ===== RELACIONES CU05 =====
UC5 --> SM : <<include>>
UC5 --> SV : <<include>>
UC5 --> SH : <<include>>
UC5 --> SC : <<include>>

' ===== RELACIONES CU06 =====
UC6 --> H1 : <<include>>
UC6 --> VR : <<include>>
UC6 --> DD : <<include>>
UC6 ..> HA : <<extend>>

' ===== RELACIONES CU07 =====
UC7 --> C1 : <<include>>
UC7 ..> C2 : <<extend>>

' ===== RELACIONES CU08 =====
UC8 --> A1 : <<include>>
UC8 --> A2 : <<include>>

' ===== RELACIONES CU09 =====
UC9 --> D1 : <<include>>
UC9 --> D2 : <<include>>
UC9 --> D3 : <<include>>
UC9 ..> D4 : <<extend>>

' ===== RELACIONES CU10 =====
UC10 --> R1 : <<include>>
UC10 --> R2 : <<include>>

' ===== RELACIONES CU11 =====
UC11 --> AD1 : <<include>>
UC11 --> AD2 : <<include>>
AD3 ..> UC11 : <<extend>>

' ===== RELACIONES CU12 =====
UC12 --> EP1 : <<include>>
UC12 ..> EP2 : <<extend>>

' ===== NOTAS RF =====
note left of UC4
Cubre RF04, RF05, RF20, RF21
(Mascotas, razas,
seguimiento morfológico, CITES)
end note

note left of UC6
Cubre RF12, RF18, RF19
(Historial + hash de autenticidad
para validez legal)
end note

note left of UC9
Cubre RF10, RF14, RF16
(Registro médico + trigger:
cronograma + alerta geofencing)
end note

note left of UC11
Cubre RF14, RF15
(Adherencia al tratamiento
confirmada por cliente)
end note

note left of UC12
Cubre RF16, RF17
(Mapa epidemiológico
y alertas zonales push)
end note

@enduml