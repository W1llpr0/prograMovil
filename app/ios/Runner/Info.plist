	<key>NSCameraUsageDescription</key>
	<string>VetCare needs camera access to take photos of your pets.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>VetCare needs photo library access to choose pet profile pictures and upload documents.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>VetCare needs permission to save photos to your library.</string>
