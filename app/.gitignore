#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Sensitive native config files — keep locally, never commit real API keys
ios/Runner/Info.plist
android/app/src/main/AndroidManifest.xml
# API key config files (each dev creates these locally from .example)
ios/Flutter/GoogleMapsKey.xcconfig
android/local.properties
