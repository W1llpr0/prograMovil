# Supabase Configuration
# Copy this file as .env.local and fill in your credentials

# Your Supabase Project URL
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Your Supabase Anon Key (public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your Supabase Service Role Key (secret - never share!)
# Get from: Supabase Dashboard → Settings → API → Service role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Project Reference ID (for CLI)
# Get from: Supabase Dashboard → Settings → General → Reference ID
SUPABASE_PROJECT_REF=YOUR_PROJECT_ID

# Password used only for the five synthetic demo accounts.
# Keep the real value in .env.local; never commit it.
VETCARE_DEMO_PASSWORD=REPLACE_WITH_A_STRONG_DEMO_PASSWORD

# Google Cloud
GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE
